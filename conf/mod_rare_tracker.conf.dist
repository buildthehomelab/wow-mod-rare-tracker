[worldserver]

########################################
# mod-rare-tracker
#
# Tracks every rare and rare elite on the open-world maps (no instances), plus the world bosses,
# and serves the list as JSON over HTTP from memory, for a live rare map on the realm's website.
# Nothing is written to disk. It can also keep playerbots that aren't grouped with a real player
# off rares and world bosses.
########################################

#
#    RareTracker.Enable
#        Description: Master switch. 0 turns off the tracker, the HTTP endpoint and the bot rule.
#        Default:     1
#

RareTracker.Enable = 1

#
#    RareTracker.BotsIgnoreRares
#        Description: Playerbots with no real player in their group (and their pets) see every
#                     open-world rare as friendly: they can't target or damage it, their AoE skips
#                     it and the rare won't aggro them. Bots grouped with a real player fight rares
#                     as normal.
#        Default:     1
#

RareTracker.BotsIgnoreRares = 1

#
#    RareTracker.BotsIgnoreWorldBosses
#        Description: The same rule for the world bosses in RareTracker.WorldBosses, so bot-only
#                     groups can't kill them before real players get there. Bots grouped with a
#                     real player fight them as normal.
#        Default:     1
#

RareTracker.BotsIgnoreWorldBosses = 1

#
#    RareTracker.RefreshSeconds
#        Description: How often the rare list is rebuilt while someone is looking at it.
#                     Minimum 5.
#        Default:     30
#

RareTracker.RefreshSeconds = 30

#
#    RareTracker.IdleSeconds
#        Description: Stop rebuilding the list when nobody has asked for it for this long. The
#                     next request gets the old list, and a fresh one follows within a second.
#        Default:     120
#

RareTracker.IdleSeconds = 120

#
#    RareTracker.IncludeEntries
#        Description: Extra creature entries to track, comma separated: creatures that aren't
#                     ranked rare but are worth hunting, like the Blood Elf Bandit (17591) on
#                     Azuremyst Isle. Every spawn of the entry shows on the map, and the bot rule
#                     covers them too. Restart to change.
#        Example:     "17591"
#        Default:     ""
#

RareTracker.IncludeEntries = ""

#
#    RareTracker.ExcludeEntries
#        Description: Creature entries to leave out, comma separated: creatures ranked rare that
#                     aren't really rares. They're also left out of the bot rule. Restart to change.
#        Example:     "12345, 23456"
#        Default:     ""
#

RareTracker.ExcludeEntries = ""

#
#    RareTracker.WorldBosses
#        Description: World boss entries to track, comma separated. They show on the map flagged
#                     as world bosses, in any phase (mod-individual-progression puts the Emerald
#                     Dragons in its own phase), and BotsIgnoreWorldBosses covers them. Empty turns
#                     world bosses off. Restart to change.
#                     6109 Azuregos, 12397 Lord Kazzak (Blasted Lands, individual progression),
#                     14887 Ysondre, 14888 Lethon, 14889 Emeriss, 14890 Taerar,
#                     17711 Doomwalker, 18728 Doom Lord Kazzak
#        Default:     "6109, 12397, 14887, 14888, 14889, 14890, 17711, 18728"
#

RareTracker.WorldBosses = "6109, 12397, 14887, 14888, 14889, 14890, 17711, 18728"

#
#    RareTracker.Http.Enable
#        Description: Serve the list at http://<BindAddress>:<Port>/rares.json (also at /, and
#                     /health answers "ok"). The HTTP settings are read at startup only.
#        Default:     1
#

RareTracker.Http.Enable = 1

#
#    RareTracker.Http.BindAddress
#        Description: Address to listen on. In Docker, 0.0.0.0 makes it reachable from other
#                     containers on the AzerothCore network (the portal) without publishing a port
#                     on the host. Use 127.0.0.1 outside Docker to keep it local.
#        Default:     "0.0.0.0"
#

RareTracker.Http.BindAddress = "0.0.0.0"

#
#    RareTracker.Http.Port
#        Default:     8095
#

RareTracker.Http.Port = 8095

#
#    RareTracker.Http.AllowOrigin
#        Description: Access-Control-Allow-Origin header, for pages that fetch the list straight
#                     from the browser. Empty leaves the header out.
#        Default:     "*"
#

RareTracker.Http.AllowOrigin = "*"
